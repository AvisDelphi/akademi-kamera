# Required for the LMS (login, courses, quizzes, dashboard, progress).
# The simulator and photo analyzer still work without these values.
# Fill them in locally in .env.local, and in Vercel > Project > Settings > Environment Variables.
# After running supabase/schema.sql, also run supabase/lms-seed.sql for demo content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
